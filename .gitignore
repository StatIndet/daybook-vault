# Obsidian
# Daybook needs app.json for attachmentFolderPath,
# but other Obsidian user/workspace settings stay private.
vault/.obsidian/*
!vault/.obsidian/app.json
!vault/.obsidian/templates.json
!vault/.obsidian/core-plugins.json

/public/
/node_modules/
/.wrangler/
.dev.vars
.env
/.daybook/
!.daybook-version
