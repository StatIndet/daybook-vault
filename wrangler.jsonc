{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daybook",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daybook-stats",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": {
    "enabled": true
  }
}
